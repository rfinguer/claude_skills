-- Sample Dashboard - Activity (PROJ-275): one row per entity; ADDITIVE bases only (Sigma recomputes the DAX measures per group).
-- Report/page filters from PROJ-275 applied here (locked/hidden in Power BI):
--   DimEntity[EntityID] not blank | DimItem[ActiveFlag] = 1 (also restricts DimEntity, bi-directional DimItem->DimEntity)
--   DimCalendar[xDaysAgo_1DayLag] >= 0 | DimCalendar[xYearsAgo_1DayLag] between 0 and 1
-- Period = Relative Date slicer (anchored on DimCalendar[TodayDate] - 1 day) intersected with the Date slicer.
-- Each flow measure keeps its DAX date role: Gross Order = OrderDateID, Cancel/Reject = CancelDateID,
-- Exits/Net Exits = ExitFact[DayId], Renewals = Events[DateID]. Snapshot measures are not date filtered.
WITH cal AS (
  SELECT DATE::DATE AS D, DATEID, WEEKENDING::DATE AS WE, TODAYDATE::DATE AS TD
  FROM SEMANTIC_VIEW(MY_DB.MY_SCHEMA.SNAPSHOT_SV
    DIMENSIONS DIMCALENDAR.DATE, DIMCALENDAR.DATEID, DIMCALENDAR.WEEKENDING, DIMCALENDAR.TODAYDATE
    WHERE DIMCALENDAR.XDAYSAGO_1DAYLAG >= 0 AND DIMCALENDAR.XYEARSAGO_1DAYLAG BETWEEN 0 AND 1)
),
anchor AS (SELECT MAX(TD) - 1 AS Y FROM cal),
rng AS (
  SELECT CASE COALESCE(__REL__, 'Last 7 Days')
           WHEN 'Yesterday'       THEN a.Y
           WHEN 'Last 7 Days'     THEN a.Y - 6
           WHEN 'Last 14 Days'    THEN a.Y - 13
           WHEN 'Last 21 Days'    THEN a.Y - 20
           WHEN 'Last 30 Days'    THEN a.Y - 29
           WHEN 'WTD (1 Day Lag)' THEN (SELECT MAX(WE) FROM cal WHERE D = a.Y) - 6
           WHEN 'MTD (1 Day Lag)' THEN DATE_TRUNC('month', a.Y)::DATE
           ELSE a.Y - 6 END AS RS,
         a.Y AS RE
  FROM anchor a
),
win AS (
  SELECT c.D, c.DATEID FROM cal c CROSS JOIN rng r
  WHERE c.D BETWEEN GREATEST(r.RS, COALESCE(__START__, r.RS)) AND LEAST(r.RE, COALESCE(__END__, r.RE))
),
props AS (
  SELECT * FROM SEMANTIC_VIEW(MY_DB.MY_SCHEMA.SNAPSHOT_SV
    DIMENSIONS DIM_ENTITY.ENTITY_ID, DIM_ENTITY.ENTITY_NAME, DIM_ENTITY.REGION, DIM_ENTITY.STATUS, DIM_ENTITY.STATUS_QTR,
               DIM_ENTITY.STATUS_YTD, DIM_ENTITY.ROLLUP, DIM_ENTITY.ROLLUP_ENTITY_NAME, DIM_ENTITY.LEVEL_1, DIM_ENTITY.LEVEL_2, DIM_ENTITY.LEVEL_3
    METRICS DIM_ITEM.NUM_ITEMS, SNAPSHOT.NUM_SNAPSHOT_ITEMS, TREND_30D, TREND_GOAL,
            EXPOSURE_NUM, LIST_PRICE.LIST_PRICE_AMT, UTIL_PCT, UTIL_GOAL_PCT
    WHERE DIM_ITEM.ACTIVE_FLAG = 1 AND DIM_ENTITY.ENTITY_ID IS NOT NULL)
  WHERE NUM_ITEMS IS NOT NULL
),
price AS (
  SELECT * FROM SEMANTIC_VIEW(MY_DB.MY_SCHEMA.PRICING_SV
    DIMENSIONS DIM_ENTITY.ENTITY_ID
    METRICS AMT_NEW_PRICE_T30, AMT_PRIOR_PRICE_T30,
            GOAL_MODEL_DAILY.AMT_NEW_GROWTH_GOAL_T30, GOAL_MODEL_DAILY.AMT_NEW_PRIOR_GOAL_T30,
            GOAL_MODEL_DAILY.AMT_RPT_GROWTH_GOAL_T30, GOAL_MODEL_DAILY.AMT_RPT_PRIOR_GOAL_T30)
),
-- 'Focus Entity' calculated table (computed without report filters, like a DAX calculated table)
focus_base AS (
  SELECT ENTITY_ID, PROJ_AMT_VAR, TREND_VAR_PCT
  FROM SEMANTIC_VIEW(MY_DB.MY_SCHEMA.SNAPSHOT_SV
    DIMENSIONS DIM_ENTITY.ENTITY_ID, DIM_ENTITY.STATUS, DIM_ENTITY.SPECIAL_FLAG
    METRICS PROJ_AMT_VAR, TREND_VAR_PCT
    WHERE DIM_ENTITY.ENTITY_ID IS NOT NULL AND DIM_ENTITY.STATUS = 'Mature'
      AND LOWER(TO_VARCHAR(DIM_ENTITY.SPECIAL_FLAG)) IN ('0', 'false'))
),
focus_r1 AS (SELECT f.*, RANK() OVER (ORDER BY PROJ_AMT_VAR ASC NULLS LAST) AS PROJ_RANK FROM focus_base f),
focus AS (
  SELECT ENTITY_ID,
         IFF(PROJ_RANK <= 10
             OR RANK() OVER (PARTITION BY (PROJ_RANK > 10) ORDER BY TREND_VAR_PCT ASC NULLS LAST) <= 10 AND PROJ_RANK > 10,
             'TRUE', 'FALSE') AS FOCUS_ENTITY_FLAG
  FROM focus_r1
),
gross AS (
  SELECT g.ENTITY_ID, SUM(g.GROSS_ORDERS) AS GROSS_ORDERS
  FROM SEMANTIC_VIEW(MY_DB.MY_SCHEMA.TRANSACTIONS_SV
         DIMENSIONS DIM_ENTITY.ENTITY_ID, ORDER_CALENDAR.DATEID METRICS ORDER_FACT.GROSS_ORDERS
         WHERE DIM_ITEM.ACTIVE_FLAG = 1) g
  JOIN win w ON w.DATEID = g.DATEID
  GROUP BY 1
),
cxl AS (
  SELECT c.ENTITY_ID, SUM(c.CANCELS) AS CANCELS, SUM(c.REJECTS) AS REJECTS
  FROM SEMANTIC_VIEW(MY_DB.MY_SCHEMA.TRANSACTIONS_SV
         DIMENSIONS DIM_ENTITY.ENTITY_ID, CANCEL_CALENDAR.DATEID METRICS CANCELS, REJECTS
         WHERE DIM_ITEM.ACTIVE_FLAG = 1) c
  JOIN win w ON w.DATEID = c.DATEID
  GROUP BY 1
),
pase AS (
  SELECT n.ENTITY_ID, SUM(n.EXITS) AS EXITS, SUM(n.NET_EXITS) AS NET_EXITS
  FROM SEMANTIC_VIEW(MY_DB.MY_SCHEMA.SNAPSHOT_SV
         DIMENSIONS DIM_ENTITY.ENTITY_ID, DIMCALENDAR.DATEID METRICS EXIT_FACT.EXITS, EXIT_FACT.NET_EXITS) n
  JOIN win w ON w.DATEID = n.DATEID
  GROUP BY 1
),
renew AS (
  SELECT r.ENTITY_ID, SUM(r.RENEWALS_2) AS RENEWALS
  FROM SEMANTIC_VIEW(MY_DB.MY_SCHEMA.SNAPSHOT_SV
         DIMENSIONS DIM_ENTITY.ENTITY_ID, DIMCALENDAR.DATEID METRICS EVENTS.RENEWALS_2) r
  JOIN win w ON w.DATEID = r.DATEID
  GROUP BY 1
)
SELECT p.ENTITY_ID       AS ENTITY_ID,
       p.ENTITY_NAME,
       p.REGION,
       p.STATUS,
       p.STATUS_QTR      AS STATUS_QTR,
       p.STATUS_YTD        AS STATUS_YTD,
       p.ROLLUP,
       p.ROLLUP_ENTITY_NAME   AS ROLLUP_ENTITY_NAME,
       p.LEVEL_1,
       p.LEVEL_2,
       p.LEVEL_3,
       f.FOCUS_ENTITY_FLAG,
       (SELECT MIN(D) FROM win) AS PERIOD_START,
       (SELECT MAX(D) FROM win) AS PERIOD_END,
       p.NUM_ITEMS                            AS ITEMS,
       p.NUM_SNAPSHOT_ITEMS                  AS SNAPSHOT_ITEMS,
       p.TREND_30D * p.NUM_SNAPSHOT_ITEMS  AS TREND_ITEMS,
       p.TREND_GOAL * p.NUM_ITEMS    AS TREND_GOAL_ITEMS,
       p.EXPOSURE_NUM,
       p.LIST_PRICE_AMT,
       p.UTIL_PCT * p.NUM_ITEMS                AS UTIL_ACTUAL_ITEMS,
       p.UTIL_GOAL_PCT * p.NUM_ITEMS           AS UTIL_GOAL_ITEMS,
       b.AMT_NEW_PRICE_T30   AS NEW_PRICE_T30,
       b.AMT_PRIOR_PRICE_T30 AS PRIOR_PRICE_T30,
       b.AMT_NEW_GROWTH_GOAL_T30     AS NEW_GROWTH_GOAL_T30,
       b.AMT_NEW_PRIOR_GOAL_T30      AS NEW_PRIOR_GOAL_T30,
       b.AMT_RPT_GROWTH_GOAL_T30     AS RPT_GROWTH_GOAL_T30,
       b.AMT_RPT_PRIOR_GOAL_T30      AS RPT_PRIOR_GOAL_T30,
       COALESCE(g.GROSS_ORDERS, 0) AS GROSS_ORDERS,
       COALESCE(c.CANCELS, 0)    AS CANCELS,
       COALESCE(c.REJECTS, 0)    AS REJECTS,
       a.EXITS,
       a.NET_EXITS,
       r.RENEWALS
FROM props p
LEFT JOIN price b ON b.ENTITY_ID = p.ENTITY_ID
LEFT JOIN focus f ON f.ENTITY_ID = p.ENTITY_ID
LEFT JOIN gross g ON g.ENTITY_ID = p.ENTITY_ID
LEFT JOIN cxl   c ON c.ENTITY_ID = p.ENTITY_ID
LEFT JOIN pase  a ON a.ENTITY_ID = p.ENTITY_ID
LEFT JOIN renew r ON r.ENTITY_ID = p.ENTITY_ID
