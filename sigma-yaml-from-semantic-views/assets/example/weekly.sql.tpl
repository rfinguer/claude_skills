-- Sample Dashboard - Activity / "Leads & Visits per Available Item" (PROJ-275). One row per entity x week ending.
-- Visual filter DimCalendar[xWeeksAgo] > 0 AND <= 52; page filters xDaysAgo_1DayLag >= 0, xYearsAgo_1DayLag 0..1.
-- Not affected by the Relative Date slicer (interaction off in Power BI).
-- Report filters: EntityID not blank, only entities that have DimItem[ActiveFlag] = 1 items.
WITH occ_props AS (
  SELECT DISTINCT ENTITY_ID FROM SEMANTIC_VIEW(MY_DB.MY_SCHEMA.SNAPSHOT_SV
    DIMENSIONS DIM_ENTITY.ENTITY_ID, DIM_ITEM.ACTIVE_FLAG)
  WHERE ACTIVE_FLAG = 1 AND ENTITY_ID IS NOT NULL
)
SELECT w.ENTITY_ID AS ENTITY_ID, w.ENTITY_NAME, w.REGION, w.STATUS, w.STATUS_QTR AS STATUS_QTR,
       w.STATUS_YTD AS STATUS_YTD, w.ROLLUP, w.ROLLUP_ENTITY_NAME AS ROLLUP_ENTITY_NAME, w.LEVEL_1, w.LEVEL_2, w.LEVEL_3,
       w.WEEKENDING::DATE AS WEEK_ENDING,
       w.NUM_NET_CONVERSIONS, w.NUM_VISITS, w.NUM_LEADS, w.NUM_WEEKLY_AVAILABLE_ITEMS,
       w.NUM_NET_CONVERSIONS_SAME_WEEK_PY, w.NUM_VISITS_SAME_WEEK_PY, w.NUM_LEADS_SAME_WEEK_PY,
       w.NUM_WEEKLY_AVAILABLE_ITEMS_SAME_WEEK_PY
FROM SEMANTIC_VIEW(MY_DB.MY_SCHEMA.SNAPSHOT_SV
  DIMENSIONS DIM_ENTITY.ENTITY_ID, DIM_ENTITY.ENTITY_NAME, DIM_ENTITY.REGION, DIM_ENTITY.STATUS, DIM_ENTITY.STATUS_QTR,
             DIM_ENTITY.STATUS_YTD, DIM_ENTITY.ROLLUP, DIM_ENTITY.ROLLUP_ENTITY_NAME, DIM_ENTITY.LEVEL_1, DIM_ENTITY.LEVEL_2, DIM_ENTITY.LEVEL_3,
             DIMCALENDAR.WEEKENDING
  METRICS EXIT_FACT.NUM_NET_CONVERSIONS, EXIT_FACT.NUM_VISITS, EXIT_FACT.NUM_LEADS, NUM_WEEKLY_AVAILABLE_ITEMS,
          EXIT_FACT_PY.NUM_NET_CONVERSIONS_SAME_WEEK_PY, EXIT_FACT_PY.NUM_VISITS_SAME_WEEK_PY,
          EXIT_FACT_PY.NUM_LEADS_SAME_WEEK_PY, NUM_WEEKLY_AVAILABLE_ITEMS_SAME_WEEK_PY
  WHERE DIMCALENDAR.XWEEKSAGO > 0 AND DIMCALENDAR.XWEEKSAGO <= 52
    AND DIMCALENDAR.XDAYSAGO_1DAYLAG >= 0 AND DIMCALENDAR.XYEARSAGO_1DAYLAG BETWEEN 0 AND 1) w
JOIN occ_props o ON o.ENTITY_ID = w.ENTITY_ID
